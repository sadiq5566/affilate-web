# Copy this file to .env.local (or just run `npm run setup`, which does it for you and creates a random JWT_SECRET).
# .env.local is git-ignored: never commit real secrets.

# --- Website ---------------------------------------------------------------
# Public URL of the site (canonical URLs, sitemap, postback URL shown in Admin -> Settings).
# Use your real https domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Region used when the visitor's country cannot be detected (UK | DE | FR | IT)
DEFAULT_REGION=UK

# --- Admin dashboard (/admin) ----------------------------------------------
# The first admin account is created on the first login if no user exists yet.
# Changing these later does NOT change an existing account: use Admin -> Settings -> password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# Secret used to sign admin sessions. `npm run setup` fills this with a random value.
# In production use a long random string (at least 32 characters).
JWT_SECRET=

# --- Database --------------------------------------------------------------
# Local SQLite database (data/app.db) and uploaded images (data/uploads).
# In production point this at a persistent disk and back it up.
DATA_DIR=./data
