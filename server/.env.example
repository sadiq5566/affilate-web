PORT=4000
# Public URL of this API (used for uploaded image URLs)
API_PUBLIC_URL=http://localhost:4000
# Public website URL (fallback redirect target)
SITE_URL=http://localhost:3000
# Comma separated list of origins allowed to call the API (dashboard + website)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# First admin account (created on first start if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# Set a long random string in production
JWT_SECRET=
# Where the SQLite database + uploads are stored
DATA_DIR=./data
